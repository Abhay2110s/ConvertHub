# --- Third-party API base URLs ---
# Both are free/keyless public APIs; these vars let you point at a
# self-hosted mirror, a different provider, or a staging endpoint
# without touching code. Leave unset to use the defaults below.

# Currency exchange rates - Frankfurter (ECB reference rates).
# Default if unset: https://api.frankfurter.dev/v1
CURRENCY_API_BASE_URL=https://api.frankfurter.dev/v1

# World time - Time.now's World Time API.
# Default if unset: https://time.now/developer/api
TIME_API_BASE_URL=https://time.now/developer/api

# --- CORS ---
# Comma-separated list of origins allowed to call this API, e.g.
# ALLOWED_ORIGINS=https://converthub.vercel.app,http://localhost:5173
# Use "*" (default) to allow any origin - fine here since there is no
# auth/cookies involved and every response is public, non-sensitive data.
ALLOWED_ORIGINS=*

# --- Rate limiting ---
# Requests allowed per IP per minute on each endpoint (best-effort,
# in-memory only - see lib/rateLimit.js for caveats on serverless).
RATE_LIMIT_PER_MINUTE=60
